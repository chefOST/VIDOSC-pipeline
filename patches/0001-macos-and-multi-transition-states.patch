+def ordered_state_indices(probs):
+    """
+    Generalized version of the causal-ordering constraint for an arbitrary
+    number of sequential states. `lookforthechange` only supports the
+    fixed 2-state + 1-action case, so this DP is used whenever the model
+    has more than one transitioning state.
+
+    probs: (T, S) per-frame scores for S sequential states.
+    Returns S indices idx[0] < idx[1] < ... < idx[S-1] maximizing
+    sum_k probs[idx[k], k], via O(T*S) dynamic programming.
+    """
+    probs = probs.detach().cpu().numpy() if torch.is_tensor(probs) else np.asarray(probs)
+    T, S = probs.shape
+    dp = np.full((T, S), -np.inf)
+    parent = np.full((T, S), -1, dtype=int)
+    dp[:, 0] = probs[:, 0]
+    for k in range(1, S):
+        best_val, best_idx = -np.inf, -1
+        for t in range(T):
+            if t > 0 and dp[t - 1, k - 1] > best_val:
+                best_val, best_idx = dp[t - 1, k - 1], t - 1
+            if best_idx != -1:
+                dp[t, k] = best_val + probs[t, k]
+                parent[t, k] = best_idx
+    indices = np.zeros(S, dtype=int)
+    indices[S - 1] = int(np.argmax(dp[:, S - 1]))
+    for k in range(S - 1, 0, -1):
+        indices[k - 1] = parent[indices[k], k]
+    return indices
+
